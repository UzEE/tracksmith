{
  "name": "tracksmith",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "tracksmith": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "cli": "bun run src/cli.ts",
    "test": "vp test run",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "vp exec tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
